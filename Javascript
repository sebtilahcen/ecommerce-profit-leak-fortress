const express = require('express');
const axios = require('axios');
const app = express();
app.use(express.json());

// --- 1. ربط شوبيفاي (Shopify Admin API) ---
app.post('/api/sync-shopify', async (req, res) => {
    const { shopDomain, accessToken } = req.body; // يتم إدخالهما من قبل العميل
    try {
        // جلب آخر الطلبات أو المنتجات لحساب التكاليف والأرباح
        const response = await axios.get(`https://${shopDomain}/admin/api/2026-01/orders.json?status=any`, {
            headers: { 'X-Shopify-Access-Token': accessToken }
        });
        
        // استخراج البيانات الحقيقية وتجهيزها للتحليل
        const orders = response.data.orders;
        // يمكنك هنا معالجة الأرقام وحساب المتوسطات الحقيقية
        res.json({ success: true, platform: 'Shopify', data: orders });
    } catch (error) {
        res.status(500).json({ success: false, error: error.message });
    }
});

// --- 2. ربط إيتسي (Etsy OpenAPI v3) ---
app.post('/api/sync-etsy', async (req, res) => {
    const { apiKey, shopId } = req.body;
    try {
        const response = await axios.get(`https://openapi.etsy.com/v3/application/shops/${shopId}/listings`, {
            headers: { 'x-api-key': apiKey }
        });
        
        res.json({ success: true, platform: 'Etsy', data: response.data });
    } catch (error) {
        res.status(500).json({ success: false, error: error.message });
    }
});

app.listen(3000, () => console.log('Server running on port 3000'));
